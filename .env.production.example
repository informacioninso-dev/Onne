# ---- Seguridad ----
SECRET_KEY=CAMBIAR_POR_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=.onne.com
CSRF_TRUSTED_ORIGINS=https://app.onne.com

# ---- SSL ----
ENABLE_SSL=True

# ---- Base de datos ----
DB_ENGINE=postgresql
DB_NAME=onne
DB_USER=onne_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_HOST=localhost
DB_PORT=5432

# ---- Multi-tenancy ----
TENANT_BASE_DOMAIN=onne.com

# Cookies entre subdominios (habilita SSO en *.onne.com)
SESSION_COOKIE_DOMAIN=.onne.com
CSRF_COOKIE_DOMAIN=.onne.com

